/* PR Info Component Styles */

PRInfo {
    layout: horizontal;
    height: 100%;
    width: 100%;
    align: center top;
}

PRInfo #pr-info-layout {
    layout: horizontal;
    height: 100%;
    width: 100%;
    max-width: 183;
}

/* Scroll container for main content */
PRInfo #main-scroll {
    width: 1fr;
    height: 100%;
    scrollbar-gutter: stable;
}

/* Inner container */
PRInfo .main-content {
    width: 100%;
    height: auto;
    padding: 1 2;
}

/* Center the document and sidebar as one unit. */
PRInfo.-wide {
    padding: 0;
}

/* Sidebar owns its scroll independently of the document. */
PRInfo .sidebar {
    width: 38;
    height: 100%;
    padding: 1 2;
    background: transparent;
    border-left: solid #363a4f;
    scrollbar-gutter: stable;
}

PRInfo.-wide .sidebar {
    width: 44;
}

PRInfo .sidebar:focus-within {
    border-left: solid $primary;
}

PRInfo .sidebar Button {
    border: none !important;
    text-style: bold !important;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    background-tint: transparent;
    tint: transparent;
}

PRInfo #sidebar-metadata {
    height: auto;
}

PRInfo #pr-checks-section .sidebar-section-title,
PRInfo #pr-files-summary-count {
    width: 1fr;
}

PRInfo SummaryOptionList {
    width: 100%;
    height: auto;
    max-height: 10;
    border: none;
    background: transparent;
    background-tint: transparent;
    padding: 0;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    overflow-x: hidden;
}

PRInfo SummaryOptionList:focus {
    border: none;
    background-tint: transparent;
}

PRInfo SummaryOptionList > .option-list--option {
    padding: 0;
    color: $foreground;
    text-style: none;
}

PRInfo SummaryOptionList > .option-list--option-highlighted {
    color: $foreground;
    background: transparent;
    text-style: none;
}

PRInfo SummaryOptionList > .option-list--option-hover {
    color: $foreground;
    background: $primary 12%;
}

PRInfo SummaryOptionList:focus > .option-list--option-highlighted {
    color: $foreground;
    background: $primary 30%;
    text-style: bold;
}

PRInfo .file-summary-group {
    height: auto;
    margin-top: 1;
}

PRInfo .file-group-totals {
    width: auto;
    height: 1;
    margin-left: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    overflow-x: hidden;
}

PRInfo .file-group-heading {
    width: 100%;
    height: 1;
}

PRInfo .file-group-heading:focus-within {
    background: $primary 30%;
}

PRInfo .file-group-count {
    width: auto;
    height: 1;
    margin-left: 1;
    color: $text-muted;
}

PRInfo .file-group-heading:focus-within .file-group-count {
    color: $foreground;
    text-style: bold;
}

PRInfo .file-group-toggle {
    width: 1fr;
    height: 1;
    min-width: 0;
    border: none;
    padding: 0;
    background: transparent !important;
    color: $foreground !important;
    text-align: left;
    content-align: left middle;
}

/* PR Header */
PRInfo #pr-title-row {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

PRInfo .pr-title {
    text-style: bold;
    color: #cad3f5;
    width: 1fr;
    height: auto;
}

PRInfo #pr-status {
    width: auto;
    height: 1;
    margin-left: 2;
}

PRInfo .pr-status-open {
    color: #a6da95;
}

PRInfo .pr-status-merged {
    color: #c6a0f6;
}

PRInfo .pr-status-closed {
    color: #ed8796;
}

PRInfo .pr-status-draft {
    color: #6e738d;
}

/* Stats bar */
PRInfo .stats-bar {
    margin-bottom: 1;
}

/* Sidebar section styles */
PRInfo .sidebar-section {
    height: auto;
    margin-bottom: 1;
}

PRInfo .sidebar-section-heading {
    height: 1;
    width: 100%;
}

PRInfo #edit-reviewers,
PRInfo #edit-assignees,
PRInfo #refresh-checks,
PRInfo #refresh-file-summary {
    width: 3;
    min-width: 3;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $text-muted;
    content-align: center middle;
}

PRInfo #edit-reviewers:hover,
PRInfo #edit-assignees:hover,
PRInfo #refresh-checks:hover,
PRInfo #refresh-file-summary:hover,
PRInfo .file-group-toggle:hover {
    background: $primary 12%;
    color: $foreground;
}

PRInfo #edit-reviewers:focus,
PRInfo #edit-assignees:focus,
PRInfo #refresh-checks:focus,
PRInfo #refresh-file-summary:focus,
PRInfo .file-group-toggle:focus {
    background: $primary 30%;
    color: $foreground;
    text-style: bold;
}

PRInfo .sidebar-section-title {
    text-style: bold;
    color: #6e738d;
    width: auto;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

PRInfo #edit-reviewers,
PRInfo #edit-assignees {
    margin-left: 1;
}

/* Comments container - must be auto height for scrolling */
PRInfo #comments-container {
    height: auto;
}

/* Review thread layout (visual style lives in ReviewThreadItem) */
PRInfo ReviewThreadItem.--thread {
    margin: 1 0 1 4;
}

PRInfo CommentCard.pending-review-summary .comment-header {
    color: #eed49f;
}

/* Placeholder text */
PRInfo .placeholder {
    color: #6e738d;
}

PRInfo #pr-reviewers {
    text-wrap: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

PRInfo.-compact #pr-info-layout {
    layout: vertical;
}

PRInfo.-compact #main-scroll {
    width: 100%;
    height: 1fr;
}

PRInfo.-compact .sidebar {
    width: 100%;
    height: 40%;
    max-height: 14;
    min-height: 5;
    border-left: none;
    border-top: solid #363a4f;
}

PRInfo.-compact .sidebar:focus-within {
    border-left: none;
    border-top: solid $primary;
}

PRInfo.-compact #sidebar-metadata {
    layout: horizontal;
    margin-bottom: 1;
}

PRInfo.-compact #sidebar-metadata .sidebar-section {
    width: 1fr;
    margin-bottom: 0;
}

/* Selected item highlight */
PRInfo Collapsible.--selected {
    border-left: solid #8aadf4;
}

PRInfo Collapsible.--thread.--selected,
PRInfo ReviewThreadItem.--thread.--selected {
    border: solid #8aadf4;
}

PRInfo Collapsible.--thread.--resolved.--selected,
PRInfo ReviewThreadItem.--thread.--resolved.--selected {
    border: solid #8aadf4;
}
