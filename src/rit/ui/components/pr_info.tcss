/* PR Info Component Styles */

PRInfo {
    layout: horizontal;
    height: 100%;
    width: 100%;
    align: center top;
}

PRInfo #pr-info-layout {
    layout: horizontal;
    height: 100%;
    width: 100%;
    max-width: 152;
}

/* Scroll container for main content */
PRInfo #main-scroll {
    width: 1fr;
    height: 100%;
    scrollbar-gutter: stable;
}

/* Inner container */
PRInfo .main-content {
    width: 100%;
    height: auto;
    padding: 1 2;
}

/* Wide screen: center the GitHub-like main/sidebar layout as one unit. */
PRInfo.-wide {
    padding: 0;
}

/* Sidebar (right side) - fixed width, no scroll */
PRInfo .sidebar {
    width: 25;
    height: 100%;
    padding: 1 2;
    background: #24273a;
    border-left: solid #363a4f;
}

/* PR Header */
PRInfo .pr-title {
    text-style: bold;
    color: #cad3f5;
    height: auto;
    margin-bottom: 1;
}

PRInfo .pr-status-open {
    color: #a6da95;
}

PRInfo .pr-status-merged {
    color: #c6a0f6;
}

PRInfo .pr-status-closed {
    color: #ed8796;
}

PRInfo .pr-status-draft {
    color: #6e738d;
}

PRInfo #branch-row {
    height: 1;
    width: 100%;
    margin-bottom: 1;
}

PRInfo .branch-info {
    color: #8aadf4;
    width: auto;
    max-width: 90%;
    height: 1;
    text-wrap: nowrap;
}

PRInfo #copy-branch {
    margin-left: 1;
}

/* Stats bar */
PRInfo .stats-bar {
    margin-bottom: 1;
}

/* Sidebar section styles */
PRInfo .sidebar-section {
    height: auto;
    margin-bottom: 1;
}

PRInfo .sidebar-section-heading {
    height: 1;
    width: 100%;
}

PRInfo #copy-branch,
PRInfo #edit-reviewers,
PRInfo #edit-assignees {
    width: 3;
    min-width: 3;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $text-muted;
    content-align: center middle;
}

PRInfo #copy-branch:hover,
PRInfo #edit-reviewers:hover,
PRInfo #edit-assignees:hover {
    background: #363a4f;
    color: $text;
}

PRInfo #copy-branch:focus,
PRInfo #edit-reviewers:focus,
PRInfo #edit-assignees:focus {
    background: $primary;
    color: $background;
}

PRInfo .sidebar-section-title {
    text-style: bold;
    color: #6e738d;
    width: auto;
}

PRInfo #edit-reviewers,
PRInfo #edit-assignees {
    margin-left: 1;
}

/* Comments container - must be auto height for scrolling */
PRInfo #comments-container {
    height: auto;
}

/* Review thread layout (visual style lives in ReviewThreadItem) */
PRInfo ReviewThreadItem.--thread {
    margin: 1 0 1 4;
}

PRInfo CommentCard.pending-review-summary .comment-header {
    color: #eed49f;
}

PRInfo CommentCard.description-container:hover,
PRInfo CommentCard.comment-box:hover {
    background: #24273a;
}

PRInfo CommentCard.thread-comment:hover,
PRInfo CommentCard.thread-reply:hover {
    background: #2f3348;
}

/* Placeholder text */
PRInfo .placeholder {
    color: #6e738d;
}

PRInfo #pr-reviewers {
    text-wrap: nowrap;
    overflow: hidden;
}

PRInfo.-compact #pr-info-layout {
    layout: vertical;
}

PRInfo.-compact #main-scroll {
    width: 100%;
    height: 1fr;
}

PRInfo.-compact .sidebar {
    layout: horizontal;
    width: 100%;
    height: auto;
    border-left: none;
    border-top: solid #363a4f;
}

PRInfo.-compact .sidebar-section {
    width: 1fr;
    margin-bottom: 0;
}

/* Selected item highlight */
PRInfo CommentCard.description-container.--selected {
    border: solid #8aadf4;
}

PRInfo CommentCard.comment-box.--selected {
    border: solid #8aadf4;
}

PRInfo CommentCard.thread-comment.--selected,
PRInfo CommentCard.thread-reply.--selected {
    background: #363a4f;
}

PRInfo Collapsible.--selected {
    border: solid #8aadf4;
}

PRInfo Collapsible.--thread.--selected,
PRInfo ReviewThreadItem.--thread.--selected {
    border: solid #8aadf4;
}

PRInfo Collapsible.--thread.--resolved.--selected,
PRInfo ReviewThreadItem.--thread.--resolved.--selected {
    border: solid #8aadf4;
}
