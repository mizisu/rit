/* rit - Global Styles */

.diff-added {
    background: $success 15%;
    color: $success;
    height: 1;
    padding: 0;
    margin: 0;
}

.diff-removed {
    background: $error 15%;
    color: $error;
    height: 1;
    padding: 0;
    margin: 0;
}

.diff-line {
    height: 1;
    padding: 0;
    margin: 0;
}

/* Vertical containers used for modified lines */
Vertical.diff-line {
    height: auto;
    padding: 0;
    margin: 0;
}

DiffView .line-prefix {
    color: $text-disabled;
}

DiffView .line-prefix.-cursor {
    color: $text;
}

Screen {
    background: $background;
}

ReviewScopePicker,
FilePickerScreen,
CommentSubmitScreen,
ReviewSubmitScreen {
    background: transparent;
}

#pr-list-tabs {
    dock: none;
    height: 2;
    background: $background;
}

#pr-list-tabs Tab {
    height: 1;
    padding: 0 1;
    background: $background;
}

#pr-list-tabs Tab.-active {
    background: $panel;
}

MainScreen {
    layers: base controls;
}

MainScreen PRSidebar {
    width: 26%;
    max-width: 48;
}

/* Keep the review control in the same cell even when the inbox covers the workspace. */
MainScreen #toggle-pr-list {
    layer: controls;
    dock: right;
    margin: 1 2 0 0;
    width: 12;
    min-width: 0;
    height: 1;
    padding: 0;
    border: none;
    background: $panel;
    color: $foreground;
}

MainScreen #toggle-pr-list:focus {
    background: $primary;
    color: $text-primary;
}

MainScreen #header-title-row,
MainScreen.pr-list-overlay #pr-list-title {
    padding-right: 13;
}

Screen.pr-list-overlay PRSidebar {
    width: 1fr;
    max-width: 100%;
}

Screen.pr-list-overlay #pr-workspace {
    display: none;
}

#pr-workspace {
    width: 1fr;
    height: 1fr;
}

#pr-list-empty {
    width: 1fr;
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}

TabbedContent {
    height: 1fr;
}

ContentSwitcher {
    height: 1fr;
}

TabPane {
    height: 1fr;
    padding: 0;
}

Tabs {
    background: $surface;
    dock: top;
}

Tab {
    padding: 0 2;
    color: $text-disabled;
    background: $surface;
}

Tab:focus {
    text-style: bold;
}

Tab.-active {
    color: $foreground;
    background: $background;
    text-style: bold;
}

Tab:hover {
    color: $foreground;
}

Footer {
    background: $surface;
}

FooterKey {
    background: $surface;
    color: $text-disabled;
}

FooterKey:hover {
    background: $primary 20%;
}

FooterKey > .footer-key--key {
    background: $primary 30%;
    color: $foreground;
}

* {
    scrollbar-background: $surface;
    scrollbar-color: $text-disabled;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $primary;
}

Static {
    color: $foreground;
}

CommentCard .comment-content Static {
    color: $text 85%;
}

CommentCard .comment-content MarkdownHeader,
CommentCard .comment-content MarkdownTableContent > .header {
    color: $text 100%;
}

CommentCard.description-container .comment-header {
    color: $text-muted;
}

Toast {
    background: $surface;
    border: solid $primary;
}
